    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "json-server": "^0.17.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.7"
  }
}
